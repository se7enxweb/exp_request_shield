# exp_request_shield: the main rule file shipped with the extension.
#
# The shield loads this file until the site has its own:
#   settings/request-shield/request-shield.rules
# (copy this file there, fix the paths below, and edit the copy; the extension's
# files are replaced by every update). See doc/configuration.md.
#
# Every rule line and setting with its default: doc/reference.md. Recipes to copy, each with
# its examples: doc/cookbook.md (and the commented recipes at the end of this file).
#
# Check after every edit:
#   php extension/exp_request_shield/bin/request-shield check <main rule file>
#   php extension/exp_request_shield/bin/request-shield test  <main rule file>
#
# The library's documentation of every line: https://github.com/cjw-network/request-shield
# (docs/reference/rule-files.md, docs/reference/settings.md, docs/use-cases/exponential.md).
#
# Copyright (C) 1998 - 2026 Exponential Foundation and 7x. GNU General Public License v2.0 (or any later version);
# the included exponential*.rules are request-shield's, under its MIT License (LICENSE.md).

ids SITE
version 0.0.1.7

# The Exponential rules of the library (examples/exponential/, copied unchanged):
# the frontend (exponential.rules) and the admin as the siteaccess /admin.
# They come first: exponential.rules sets a mode, a store and a log of its own,
# and the settings below must come after it to win.
include     exponential-admin-uri.rules

# A default installation has more admin siteaccesses than /admin: adminui
# (exp_adminui), editor, and older admin designs. The same rules as the
# library's "match /admin/**" for them.
match regex ^/(adminui|editor|admin2|admin3|admin4|admin4l|admintest_[a-z0-9_]+)(/|$) {
  [SITE-ADMIN-SYS]   unblock [EXP-SYSVIEW] [EXP-MODULES]       # the admin siteaccesses use system URLs and admin modules
  expect GET /adminui/content/view/full/2 with pass        answered
  expect GET /editor/content/view/full/2 with pass         answered
  expect GET /adminui/setup/info with pass                 answered
  [SITE-ADMIN-POST]  allow POST                               # editors save everywhere in the admin
  expect POST /editor/content/edit/87/1/eng-GB with pass   answered
  [SITE-ADMIN-CHECK] challenge                                # every editor: the browser check once per pass
  expect GET /adminui/dashboard                            check
  [SITE-ADMIN-AREA]  backend                                  # counted apart in the statistics
  [SITE-ADMIN-Q]     query * text                             # all parameters known, free text scanned for attacks
  expect GET /adminui/content/edit/87?anything=goes with pass   answered
}
expect GET /adminuix/content/view/full/2                  404 by EXP-SYSVIEW   # a frontend address that only starts like one
expect GET /setup/info                                     404 by EXP-MODULES   # admin modules stay closed in the frontend
[SITE-ADMIN-BG] api-path regex ^/(adminui|editor|admin2|admin3|admin4|admin4l|admintest_[a-z0-9_]+)/user/megamenu/   # the admin's background fragments: the check as JSON, never the page
expect GET /adminui/user/megamenu/setup with pass                 answered
expect GET /adminui/user/megamenu/setup header X-Requested-With:XMLHttpRequest   json-check by SITE-ADMIN-CHECK
expect GET /adminui/user/megamenu/setup                       json-check by SITE-ADMIN-CHECK   # also without the fetch headers

# AN ADMIN ON A HOST OF ITS OWN (edit.example.org, siteaccess matching by host):
# the rules above cover admins reached by path only. On such a site, make the
# site's own file (settings/request-shield/request-shield.rules) like this --
# exponential.rules first, the settings after it, the admin host's site block
# last (after the first site block only further site blocks may follow):
#   include exponential.rules
#   ... the settings of this file (mode, store-dir, log, ...) ...
#   include exponential-admin-host.rules   (a copy, with "site admin.example.org"
#                                            replaced by the admin's host names, and
#                                            its own "include exponential.rules" removed)
# (store-dir and log stay relative to this file, or absolute). See doc/configuration.md.

# --------------------------------------------------------------------------
# Mode. "enforce": the protection is on as installed -- scanners, floods,
# stray forms and system URLs are refused, the login and the admin's forms
# ask for the browser check. Rules with "monitor" in front of them stay
# watched only. To watch everything first and refuse nobody (logged as
# monitor-...), write "set mode monitor"; "set mode off" switches it off.
# --------------------------------------------------------------------------
set         mode enforce

# An Exponential site is no WordPress: its addresses (/wp-admin, /wp-login.php, xmlrpc.php, wp-content ...) are
# asked for by scanners only. The library's @wordpress set refuses them (404) before the kernel starts.
include     @wordpress
expect GET /wp-admin                                       404 by WP-FOLDERS

# Search engines and AI crawlers are welcome: Google, Bing, Apple, DuckDuckGo and the AI crawlers whose operators
# publish how to verify them (OpenAI, Anthropic, Perplexity ...). A crawler counts as verified only by where it comes
# from (its operator's published address list, or reverse and forward DNS), never by the name it sends; a verified
# crawler never gets the browser check (it runs no JavaScript), only the pace limits. One that merely sends the name
# is treated like any visitor. These lines say the library's default out loud; write "block" for a kind you do not want.
crawlers    search       allow
crawlers    ai-search    allow
crawlers    ai-user      allow
crawlers    ai-training  allow
expect GET /user/login ua "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)" from 66.249.66.1   answered   # the real Googlebot: no browser check
expect GET /user/login ua "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)" from 198.51.100.7  check by EXP-LOGIN   # the name alone: checked like anyone

# Public blocklists of networks nobody should hear from: hijacked or criminal networks (Spamhaus DROP) and botnet
# command servers (abuse.ch Feodo). Fetched by the extension's cronjob part (requestshield, daily); until the first
# fetch they decide nothing.
feed spamhaus-drop deny
feed feodo deny

# --------------------------------------------------------------------------
# Where the shield writes: relative paths are relative to this file. From
# extension/exp_request_shield/rules/ three levels up is the installation's
# root, so everything goes to var/request-shield/. Keep it out of the
# document root's reach (the web server must never hand out var/request-shield/).
# --------------------------------------------------------------------------
set         store-dir ../../../var/request-shield/store
set         log ../../../var/request-shield/log/shield.log
set         log-level flag

# The statistics pages of the library (requests, rules, status codes per hour)
# under /rs/stats/. They are served by the shield itself and need access rules
# of their own before they are switched on: see doc/dashboard.md.
set         stats off

# The library serves pages of its own below the dashboard path (/rs): the
# statistics, the firewall's rules, live and lists pages, the API. They stay
# closed to everyone but the server itself until the site opens them, either
# for its addresses ("restrict /rs/** to 192.0.2.10") or with a login token
# ("dashboard-access * sha256:...", made by bin/request-shield access-token).
# The admin's Setup > Request shield page needs none of this.
# In monitor mode a restrict refuses nobody: the JSON API stays off, and a site
# that opens these pages gives them a login (dashboard-access), which is checked
# in every mode.
[SITE-DASH]  restrict /rs/** to 127.0.0.1 ::1
set         api off
expect GET /rs/stats/overview from 198.51.100.27 403 by SITE-DASH    # the shield's own pages, from outside
expect GET /rs/stats/overview from 127.0.0.1 answered                 # from the server itself

# ==========================================================================
# RECIPES -- commented out; nothing below changes what the shield decides.
# Copy a recipe into the site's own file (settings/request-shield/
# request-shield.rules), take the "#" away, replace the documentation
# addresses (192.0.2.x, 198.51.100.x, 203.0.113.x) and names, then run
# "request-shield check" and "test". Each was tested against these rules;
# doc/cookbook.md explains every one.
# ==========================================================================

# --- The site's names, and the admin modules behind every URI siteaccess ---
#host        www.example.org example.org admin.example.org
#replace     [EXP-MODULES] block regex (?i)^(/(site|ger|eng|fre))?/(setup|class|section|role|state|workflow|trigger|visual|package|infocollector|url|ezinfo|collaboration|pdf)(/|$)
#expect GET /fre/setup/info                         404 by EXP-MODULES

# --- A slower search server: five searches a minute (keep the "at", or every page counts) ---
#replace     [EXP-SEARCHES] limit searches 5/min on-exceeded challenge at regex (?i)/content/(advanced)?search(/|$)
#expect GET /content/search?SearchText=yoga  times 6   check by EXP-SEARCHES

# --- Downloads (PDFs, office files, archives): 30 a minute per visitor, then the check ---
#match /content/download/** {
#  [SITE-DOWNLOADS] limit downloads 30/min on-exceeded challenge
#  expect GET /content/download/12/34/file/report.zip  times 31   check
#}
# ... or the browser check before every PDF, once an hour (verified crawlers never get it):
#[SITE-PDF-CHECK] challenge **/content/download/**/*.pdf max-age 1h

# --- Help PDFs and the help search, when the help is public ---
#match regex (?i)^(/[a-z0-9_]+)?/exphelp/(pdf|search)(/|$) {
#  [SITE-HELP-HEAVY] limit helpheavy 10/min on-exceeded challenge
#}

# --- Ten registrations an hour per visitor ---
#match /user/register/** {
#  [SITE-REGISTER] limit registrations 10/hour on-exceeded challenge
#}

# --- The forms of an extension of your own (module "myforms") ---
#[SITE-MYFORMS-POST]  allow POST **/myforms/**
#[SITE-MYFORMS-CHECK] challenge POST **/myforms/** max-age 30m

# --- The REST API: PUT, PATCH, DELETE there only, no browser check, a budget of its own ---
#method      GET HEAD POST OPTIONS PUT PATCH DELETE
#[SITE-REST-METHODS] allow PUT PATCH DELETE /api/**
#[SITE-REST-NOCHECK] challenge-exempt /api/**
#[SITE-REST-BUDGET]  limit api 300/min at /api/**

# --- The administration only from the office (198.51.100.7: the address "test" sends its examples from) ---
#[SITE-ADMIN-NET] restrict /admin/** to 192.0.2.0/24 2001:db8:10::/48 198.51.100.7
#exempt      192.0.2.0/24                                       # the office: never counted, never checked

# --- Webhooks posted by a provider's servers ---
#[SITE-HOOK-POST]    allow POST /webhook/**
#[SITE-HOOK-ORIGIN]  post-origin except /webhook/**
#[SITE-HOOK-NOCHECK] challenge-exempt /webhook/**

# --- An uptime monitor, with an end date ---
#exempt      203.0.113.10 until 2027-12-31

# --- A gallery site and a busy intranet (keep the "at regex", so pages and images count apart) ---
#replace     [EXP-IMAGES] limit images 6000/min on-exceeded challenge at regex ^((/[a-z0-9_]+)?/content/image/|/index_image\.php|/var/([^/]+/)?storage/images(-versioned)?/)
#replace     [EXP-PACE] limit pages 600/min challenge-at 240 on-exceeded challenge at regex ^(?!(/[a-z0-9_]+)?/content/image/|/index_image\.php|/var/([^/]+/)?storage/images(-versioned)?/|/admin/(explayouts_ui_api/app/api/|ezjscore/call(/|$)))

# --- A content section whose alias looks like a system path ---
#[SITE-DOC]   unblock [EXP-INTERNAL] at /doc /doc/**

# --- Print layouts (scanners wrap their paths in them) and keyword lists ---
#[SITE-LAYOUT-SET] challenge **/layout/set/** max-age 12h
#match regex (?i)/content/keyword(/|$) {
#  [SITE-KEYWORDS] limit keywords 20/min on-exceeded challenge
#}

# --- Query parameters of an extension, with their types ---
#[SITE-SHOP-Q] query sort word  page int  color list at /shop/**

# --- Behind a proxy: name it, or every visitor seems to come from it ---
#trust       10.0.0.0/8                                         # your load balancer
#trust       127.0.0.1 ::1                                      # nginx in front on the same server (else: everyone is 127.0.0.1, which is exempt)
# Cloudflare: its ranges from https://www.cloudflare.com/ips/, for example
#trust       173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
#trust       2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# --- Several web servers: one pass-cookie secret, one count ---
#set         secret ${SHIELD_SECRET}
#set         store file

# --- Watch a new rule first; enforce a scanner ban (test it with --as-written) ---
#[SITE-OLDAPI] monitor block /old-api/**
#[SITE-BAN] ban after 20 refusals in 10m for 1h

# --- Your own texts and error page ---
#set         text.en.title One moment, please
#set         text.de.title Einen Moment, bitte
#set         error-page 404 errors/4xx.html

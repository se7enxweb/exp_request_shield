# request-shield for an Exponential site whose admin is the siteaccess /admin
# (URI matching: www.example.org/admin/…). The main file: load this one.
#
#   CjwNetwork\RequestShield\Shield::protectFile('/path/to/exponential-admin-uri.rules');
#
# The frontend's rules come from exponential.rules; here only what the admin
# needs on top. Reasons: docs/use-cases/exponential.md.

ids EXP
version 2026-11-16.1

include     exponential.rules                                  # the frontend: system URLs, forms, search, pace

# The admin's pages load parts of themselves in the background (fetch): the mega
# menu today (/admin/user/megamenu/<tab>), ezjscore calls and other fragments
# tomorrow. A script cannot show or solve the check page, so a check comes as
# JSON (429, Request-Shield-Challenge) and the page can reload itself. The shield
# already answers any fetch so (Sec-Fetch-Dest: empty, X-Requested-With); this
# names the paths for clients that send neither.
[EXP-ADMIN-BG]      api-path /admin/user/megamenu/**          # the admin's background fragments: the check as JSON, never the page
expect GET /admin/user/megamenu/setup with pass                answered
expect GET /admin/user/megamenu/setup header X-Requested-With:XMLHttpRequest   json-check by EXP-ADMIN-CHECK   # no pass: JSON, not the HTML check page
expect GET /admin/user/megamenu/users                          json-check by EXP-ADMIN-CHECK   # also without the fetch headers

# The layout editor (Exponential Layouts) saves with PUT and PATCH and discards a draft with DELETE.
method      GET HEAD POST OPTIONS PUT PATCH DELETE
[EXP-ADMIN-SPA] allow PUT PATCH DELETE /admin/explayouts_ui_api/**   # the layout editor's API: PUT, PATCH and DELETE, nowhere else
expect DELETE /admin/explayouts_ui_api/app/api/layouts/19/draft with pass   answered
expect PATCH /admin/explayouts_ui_api/app/api/layouts/19 with pass   answered
expect DELETE /admin/content/view/full/2 with pass   405   # anywhere else in the admin: still refused

# Setup > Ini settings (/admin/settings/view/admin/site.ini) and the template
# views (/admin/visual/templateview/node/view/full.tpl) are module views named
# after a file: EXP-INI refused them with 404, so the admin could not show any
# setting or template. Taken back only there; every other address named .ini or
# .tpl stays refused.
[EXP-ADMIN-INI]   unblock [EXP-INI] at /admin/settings/view/** /admin/settings/edit/** /admin/visual/templateview/** /admin/visual/templateedit/** /admin/visual/templatecreate/**
expect GET /admin/settings/view/admin/site.ini with pass                     answered
expect GET /admin/settings/edit/admin/site.ini/DebugSettings/DebugOutput/siteaccess with pass   answered
expect GET /admin/visual/templateview/node/view/full.tpl with pass           answered
expect POST /admin/visual/templateedit/node/view/full.tpl with pass          answered
expect GET /admin/settings/site.ini with pass                                404 by EXP-INI
expect GET /admin/extension/shop/settings/shop.ini.append.php with pass      404 by EXP-INI
expect GET /settings/view/admin/site.ini                                     404 by EXP-INTERNAL   # outside the admin: still refused

match /admin/** {
  [EXP-ADMIN-SYS]   unblock [EXP-SYSVIEW] [EXP-MODULES]       # the admin uses system URLs (/admin/content/view/full/2) and its modules
  expect GET /admin/content/view/full/2 with pass    answered
  expect GET /admin/setup/info with pass              answered
  [EXP-ADMIN-POST]  allow POST                                # editors save everywhere in the admin
  expect POST /admin/class/edit/1 with pass          answered
  expect POST /admin/content/edit/87/1/ger-DE with pass  answered
  [EXP-ADMIN-CHECK] challenge                                 # every editor: the browser check once per pass
  expect GET /admin/dashboard                         check
  expect GET /admin/content/view/full/2 header Sec-Fetch-Dest:empty   json-check   # any fetch of the admin's: the check as JSON
  expect POST /admin/class/edit/1 header Origin:https://www.example.org   check
  expect GET /admin/user/login                        check by EXP-LOGIN   # the login: the frontend's rule
  [EXP-ADMIN-AREA]  backend                                   # the editors' area: its forms counted apart in the statistics
  [EXP-ADMIN-Q]     query * text                              # the admin's parameters: all known, free text scanned for attacks
  expect GET /admin/content/edit/87?anything=goes with pass   answered
  expect GET /admin/content/edit/87?x=%3Cscript%3E with pass   403 by ATK-XSS-TAG   # still scanned
  #[EXP-ADMIN-NET]  restrict to 192.0.2.0/24                  # the office only (or a VPN): take the "#" away
}
# The admin login (/admin/user/login) is checked by EXP-LOGIN: a fresh check, from the last 15 minutes.

# One host for visitors and editors: the pass lasts as long for both
# (exponential.rules: 2 hours). Editors who lose their pass while editing are
# checked when they next save, and the form is sent again by itself. A working
# day without a check needs "set pass-ttl 8h" here -- for visitors too.
#set        pass-ttl 8h                                        # editors: one check a working day (visitors too)
